# API base URL. Use "/api" when the Express server serves this build.
# For a separately hosted frontend set the full URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Socket.io server origin. Leave empty to use the page origin (recommended when
# the same Express server serves this build). Example: https://api.example.com
VITE_SOCKET_URL=
