{
  "name": "edupulse",
  "version": "1.0.0",
  "description": "EduPulse - Digital Educational Data Management Platform (Smart Education, Attendance Automation, Anti-Proxy)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "start": "cd server && npm start",
    "start:server": "cd server && npm start",
    "db:seed": "cd server && npm run db:seed",
    "db:push": "cd server && npm run db:push",
    "db:generate": "cd server && npm run db:generate",
    "db:studio": "cd server && npm run db:studio",
    "smoke": "cd server && npm run smoke"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
