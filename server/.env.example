# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5001

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres@localhost:5433/edupulse?schema=public"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 48
# A production process refuses to start with the example value.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Optional separate secret for signing rolling QR tokens. Falls back to
# JWT_SECRET when omitted.
QR_SECRET=""

# ---------------------------------------------------------------------------
# Rolling QR
# ---------------------------------------------------------------------------
QR_REFRESH_INTERVAL=7000
QR_VALIDITY_MS=15000

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (the frontend URL).
CLIENT_URL="http://localhost:5173"
# Public URL of this API server (used for same-origin CORS checks).
PUBLIC_URL="http://localhost:5001"

# Set true when this Express server should also serve client/dist.
SERVE_CLIENT=false
# Set true behind Nginx/Render/Railway/Fly/Heroku style reverse proxies.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Security / limits
# ---------------------------------------------------------------------------
# Public registration can never create ADMIN accounts unless explicitly enabled.
ADMIN_SIGNUP_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
